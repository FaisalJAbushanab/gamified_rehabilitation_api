# Copy to .env and fill in. Values here are examples only.
ENV=dev                      # dev | prod | test
# DATA_DIR=./data            # database, encrypted audio, media
# DATABASE_URL=postgresql+psycopg://user:pass@host/naming_app   # default: SQLite in DATA_DIR
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Required in prod (dev generates throwaway values under DATA_DIR)
JWT_SECRET=
AUDIO_KEY_B64=               # python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"

# ASR: google | azure | manual (manual = dev/testing only, refused in prod)
ASR_PROVIDER=manual
ASR_FALLBACK=none
ASR_LOCALE=ar-AE
ASR_TIMEOUT_S=5
GOOGLE_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Dev only: allow sessions before every cue asset exists
REQUIRE_COMPLETE_CONTENT=true
